<li class="riga">
  <a class="riga-immagine illustrazione" href="{{ articolo.url | url }}" tabindex="-1" aria-hidden="true">
    {% if articolo.data.copertina and articolo.data.copertina.file %}
    <img src="{{ articolo.data.copertina.file | url }}" alt="" width="1200" height="600" loading="lazy" decoding="async">
    {% else %}
    {{ articolo.data.titolo | illustrazione(articolo.data.copertina.forma) | safe }}
    {% endif %}
  </a>
  <div class="riga-testo">
    <p class="riga-meta">
      <a class="categoria" href="{{ articolo.data.categoria | urlCategoria | url }}">{{ articolo.data.categoria }}</a>
      <time datetime="{{ articolo.date | dataIso }}">{{ articolo.date | dataIt }}</time>
    </p>
    <h3 class="riga-titolo"><a href="{{ articolo.url | url }}">{{ articolo.data.titolo }}</a></h3>
    {% if articolo.data.sottotitolo %}
    <p class="riga-sommario">{{ articolo.data.sottotitolo }}</p>
    {% endif %}
  </div>
</li>
