<article class="card">
  <p class="kicker">{{ articolo.data.categoria }}</p>
  <h3><a href="{{ articolo.url | url }}">{{ articolo.data.titolo }}</a></h3>
  {% if articolo.data.sottotitolo %}
  <p>{{ articolo.data.sottotitolo }}</p>
  {% endif %}
  <p class="meta">
    <time datetime="{{ articolo.date | dataIso }}">{{ articolo.date | dataIt }}</time>
  </p>
</article>
