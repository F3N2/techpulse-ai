---
layout: base.njk
---
{% set lettura = content | tempoLettura %}
{% set vicini = collections.articoli | vicini(page.url) %}
{% set correlati = collections.articoli | correlati(page.url, categoria, 3) %}

<article class="articolo">

  <div class="container">
    <header class="articolo-testata">
      <p class="riga-meta articolo-meta">
        <a class="categoria" href="{{ categoria | urlCategoria | url }}">{{ categoria }}</a>
        <time datetime="{{ page.date | dataIso }}">{{ page.date | dataIt }}</time>
        <span>{{ lettura }}</span>
      </p>
      <h1 class="articolo-titolo">{{ titolo }}</h1>
      {% if sottotitolo %}
      <p class="articolo-sommario">{{ sottotitolo }}</p>
      {% endif %}
    </header>

    <figure class="articolo-immagine illustrazione">
      {{ id | illustrazione | safe }}
    </figure>

    {% if punti_chiave and punti_chiave.length %}
    <aside class="articolo-punti finestra" aria-label="Punti chiave">
      <h2>In breve</h2>
      <ul>
        {% for punto in punti_chiave %}
        <li>{{ punto }}</li>
        {% endfor %}
      </ul>
    </aside>
    {% endif %}

    <div class="prose articolo-corpo">
      {{ content | safe }}
    </div>

    {% if fonti and fonti.length %}
    <section class="fonti" aria-labelledby="titolo-fonti">
      <h2 id="titolo-fonti">Fonti consultate</h2>
      <ol>
        {% for fonte in fonti %}
        <li>
          {% if fonte.url and (fonte.url.startsWith("https://") or fonte.url.startsWith("http://")) %}
          <a href="{{ fonte.url }}" target="_blank" rel="noopener noreferrer">{{ fonte.titolo or fonte.url }}</a>
          {% else %}
          {{ fonte.titolo }}
          {% endif %}
        </li>
        {% endfor %}
      </ol>
    </section>
    {% endif %}

    {% if note_verifica %}
    <aside class="finestra articolo-verifica" aria-label="Nota sulla verifica delle informazioni">
      <h2>Nota sulla verifica</h2>
      <p>{{ note_verifica }}</p>
    </aside>
    {% endif %}

    <aside class="nota-ai" aria-label="Trasparenza sull'uso dell'intelligenza artificiale">
      <p>
        Articolo redatto con l'ausilio dell'intelligenza artificiale a partire dalle
        fonti indicate e approvato prima della pubblicazione.
        <a href="{{ '/informativa-ai/' | url }}">Come usiamo l'AI</a>.
      </p>
    </aside>

    {% if vicini.precedente or vicini.successivo %}
    <nav class="vicini" aria-label="Articoli in sequenza">
      {% if vicini.precedente %}
      <a class="vicino" href="{{ vicini.precedente.url | url }}">
        <span class="vicino-etichetta">Articolo precedente</span>
        <span class="vicino-titolo">{{ vicini.precedente.data.titolo }}</span>
      </a>
      {% endif %}
      {% if vicini.successivo %}
      <a class="vicino" href="{{ vicini.successivo.url | url }}">
        <span class="vicino-etichetta">Articolo successivo</span>
        <span class="vicino-titolo">{{ vicini.successivo.data.titolo }}</span>
      </a>
      {% endif %}
    </nav>
    {% endif %}

    <p class="articolo-indietro">
      <a class="btn btn-secondario" href="{{ '/ultime-notizie/' | url }}">Tutte le notizie</a>
    </p>
  </div>

  {% if correlati.length %}
  <section class="container correlati" aria-labelledby="correlati">
    <h2 class="titoletto" id="correlati">Continua a leggere</h2>
    <ul class="elenco">
      {% for articolo in correlati %}
        {% include "card-articolo.njk" %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</article>
