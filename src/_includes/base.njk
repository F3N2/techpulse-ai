<!doctype html>
<html lang="{{ site.lingua }}" data-tema="scuro">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests">
  <script src="{{ '/assets/js/tema.js' | url }}?v={{ '/assets/js/tema.js' | impronta }}"></script>
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <title>{% if titolo %}{{ titolo }} · {% endif %}{{ site.nome }}</title>
  <meta name="description" content="{{ descrizione or site.descrizione }}">
  <meta name="theme-color" content="#101010">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/favicon.svg' | url }}">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:locale" content="it_IT">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ titolo or site.nome }}">
  <meta property="og:description" content="{{ descrizione or site.descrizione }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}?v={{ '/assets/css/style.css' | impronta }}">
</head>
<body>
  <a class="skip" href="#contenuto">Vai al contenuto</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.nome }} – Home">
        <svg viewBox="0 0 26 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="12" r="3.3"/><path d="M12.4 5.6 17 2.7M12.4 12h9.6M12.4 18.4 17 21.3"/></svg>
        <span>FARO<b>.</b></span>
      </a>

      <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Apri o chiudi il menu">
      <label for="menu-toggle" class="menu-button" aria-hidden="true"><span></span><span></span><span></span></label>

      <nav class="nav" aria-label="Navigazione principale">
        <a href="{{ '/' | url }}">Home</a>
        <a href="{{ '/ultime-notizie/' | url }}">Ultime notizie</a>
        {% for c in categorie %}
        <a href="{{ ('/' ~ c.slug ~ '/') | url }}">{{ c.nome }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="contenuto">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h4>{{ site.nome }}<span class="punto">.</span></h4>
          <p>{{ site.descrizione }}</p>
        </div>
        <div>
          <h4>Sezioni</h4>
          <ul>
            <li><a href="{{ '/ultime-notizie/' | url }}">Ultime notizie</a></li>
            {% for c in categorie %}
            <li><a href="{{ ('/' ~ c.slug ~ '/') | url }}">{{ c.nome }}</a></li>
            {% endfor %}
          </ul>
        </div>
        <div>
          <h4>Informazioni</h4>
          <ul>
            <li><a href="{{ '/chi-siamo/' | url }}">Chi siamo</a></li>
            <li><a href="{{ '/contatti/' | url }}">Contatti</a></li>
            <li><a href="{{ '/privacy-policy/' | url }}">Privacy Policy</a></li>
            <li><a href="{{ '/cookie-policy/' | url }}">Cookie Policy</a></li>
            <li><a href="{{ '/termini-e-condizioni/' | url }}">Termini e condizioni</a></li>
            <li><a href="{{ '/informativa-ai/' | url }}">Uso dell'intelligenza artificiale</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-strumenti">
        <fieldset class="tema">
          <legend>Tema di lettura</legend>
          <label class="tema-opzione">
            <input type="radio" name="tema" value="chiaro" id="tema-chiaro">
            <span>Chiaro</span>
          </label>
          <label class="tema-opzione">
            <input type="radio" name="tema" value="scuro" id="tema-scuro" checked>
            <span>Scuro</span>
          </label>
          <label class="tema-opzione">
            <input type="radio" name="tema" value="lettura" id="tema-lettura">
            <span>Lettura</span>
          </label>
        </fieldset>
        <p class="tema-nota">La scelta resta salvata su questo browser.</p>
      </div>

      {% include "dati-titolare.njk" %}

      <p class="footer-note">
        Gli articoli sono redatti con l'ausilio dell'intelligenza artificiale e
        approvati prima della pubblicazione. Le fonti sono sempre indicate.
        Marchi e loghi citati appartengono ai rispettivi proprietari.
      </p>
    </div>
  </footer>
</body>
</html>
