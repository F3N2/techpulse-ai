---
layout: base.njk
---
{% set tutti = collections.articoli %}
{% set inEvidenza = tutti | first %}

<section class="hero container fade-in">
  <h1>Il futuro digitale, <em>spiegato bene</em>.</h1>
  <p>{{ site.descrizione }}</p>
  <p>
    <a class="btn" href="{{ '/ultime-notizie/' | url }}">Leggi le ultime notizie</a>
  </p>
</section>

{% if tutti.length %}

<section class="container" aria-labelledby="titolo-evidenza">
  <h2 class="section-title" id="titolo-evidenza">In evidenza</h2>
  <article class="card card-evidenza fade-in">
    <span class="badge">{{ inEvidenza.data.categoria }}</span>
    <h3><a href="{{ inEvidenza.url | url }}">{{ inEvidenza.data.titolo }}</a></h3>
    {% if inEvidenza.data.sottotitolo %}
    <p>{{ inEvidenza.data.sottotitolo }}</p>
    {% endif %}
    <p class="meta">
      <time datetime="{{ inEvidenza.date | dataIso }}">{{ inEvidenza.date | dataIt }}</time>
    </p>
  </article>
</section>

<section class="container" aria-labelledby="titolo-ultime">
  <h2 class="section-title" id="titolo-ultime">Ultime notizie</h2>
  <div class="grid">
    {% for articolo in tutti %}
      {% if loop.index > 1 and loop.index <= 7 %}
        {% include "card-articolo.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  <p><a class="btn" href="{{ '/ultime-notizie/' | url }}">Tutte le notizie</a></p>
</section>

{% else %}

<section class="container">
  <div class="card stato-vuoto fade-in">
    <h2>Nessun articolo pubblicato</h2>
    <p>
      Stiamo preparando i primi contenuti. Ogni articolo viene pubblicato
      solo dopo una verifica e un'approvazione della redazione.
    </p>
  </div>
</section>

{% endif %}

<section class="container" aria-labelledby="titolo-categorie">
  <h2 class="section-title" id="titolo-categorie">Categorie</h2>
  <div class="grid">
    {% for c in categorie %}
    <article class="card fade-in">
      <span class="badge">{{ c.nome }}</span>
      <p>{{ c.descrizione }}</p>
      <p><a href="{{ ('/' ~ c.slug ~ '/') | url }}">Vai alla sezione →</a></p>
    </article>
    {% endfor %}
  </div>
</section>

{% for c in categorie %}
  {% if c.slug != "tecnologia" %}
    {% set articoliCat = tutti | perCategoria(c.nome) %}
    {% if articoliCat.length %}
<section class="container" aria-labelledby="sezione-{{ c.slug }}">
  <h2 class="section-title" id="sezione-{{ c.slug }}">{{ c.nome }}</h2>
  <div class="grid">
    {% for articolo in articoliCat %}
      {% if loop.index <= 3 %}
        {% include "card-articolo.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  <p><a href="{{ ('/' ~ c.slug ~ '/') | url }}">Tutti gli articoli: {{ c.nome }} →</a></p>
</section>
    {% endif %}
  {% endif %}
{% endfor %}
