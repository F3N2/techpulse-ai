---
layout: base.njk
---
{% set tutti = collections.articoli %}
{% set inEvidenza = tutti | first %}

{% if tutti.length %}

<section class="container" aria-label="Notizie principali">
  <div class="home-grid mt-1">
    <article class="lead">
      <p class="kicker">{{ inEvidenza.data.categoria }}</p>
      <h2><a href="{{ inEvidenza.url | url }}">{{ inEvidenza.data.titolo }}</a></h2>
      {% if inEvidenza.data.sottotitolo %}
      <p>{{ inEvidenza.data.sottotitolo }}</p>
      {% endif %}
      <p class="meta">
        <time datetime="{{ inEvidenza.date | dataIso }}">{{ inEvidenza.date | dataIt }}</time>
      </p>
    </article>

    <aside aria-label="Ultime notizie">
      <h2 class="section-head mt-0">Ultime notizie</h2>
      <ul class="lista">
        {% for articolo in tutti %}
          {% if loop.index > 1 and loop.index <= 7 %}
        <li>
          <p class="kicker">{{ articolo.data.categoria }}</p>
          <a href="{{ articolo.url | url }}">{{ articolo.data.titolo }}</a>
          <p class="meta">
            <time datetime="{{ articolo.date | dataIso }}">{{ articolo.date | dataIt }}</time>
          </p>
        </li>
          {% endif %}
        {% endfor %}
      </ul>
      <p><a href="{{ '/ultime-notizie/' | url }}">Tutte le notizie →</a></p>
    </aside>
  </div>
</section>

{% else %}

<section class="container">
  <div class="home-hero">
    <p class="kicker">Il magazine italiano sull'intelligenza artificiale</p>
    <h1>L'AI, <em>spiegata.</em></h1>
    <p>{{ site.nome }} sceglie ogni giorno le notizie tecnologiche che contano, le verifica sulle fonti originali e le racconta in italiano, senza rumore.</p>
  </div>
  <div class="stato-vuoto">
    <h2>Nessun articolo pubblicato</h2>
    <p>
      Stiamo preparando i primi contenuti. Ogni articolo viene pubblicato
      solo dopo una verifica e un'approvazione della redazione.
    </p>
  </div>
</section>

{% endif %}

{% for c in categorie %}
  {% set articoliCat = tutti | perCategoria(c.nome) %}
  {% if articoliCat.length %}
<section class="container" aria-labelledby="sezione-{{ c.slug }}">
  <h2 class="section-head" id="sezione-{{ c.slug }}">{{ c.nome }}</h2>
  <div class="grid">
    {% for articolo in articoliCat %}
      {% if loop.index <= 3 %}
        {% include "card-articolo.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  <p><a href="{{ ('/' ~ c.slug ~ '/') | url }}">Tutti gli articoli: {{ c.nome }} →</a></p>
</section>
  {% endif %}
{% endfor %}
