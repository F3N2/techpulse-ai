---
layout: base.njk
---
{% set tutti = collections.articoli %}
{% set inEvidenza = tutti | first %}

{% if tutti.length %}

<section class="container" aria-label="Notizie principali">
  <div class="prima-pagina">
    <article class="apertura">
      <a class="apertura-immagine illustrazione" href="{{ inEvidenza.url | url }}" tabindex="-1" aria-hidden="true">
        {% if inEvidenza.data.copertina and inEvidenza.data.copertina.file %}
        <img src="{{ inEvidenza.data.copertina.file | url }}" alt="" width="1200" height="600" decoding="async">
        {% else %}
        {{ inEvidenza.data.titolo | illustrazione(inEvidenza.data.copertina.forma) | safe }}
        {% endif %}
      </a>
      <p class="riga-meta">
        <a class="categoria" href="{{ inEvidenza.data.categoria | urlCategoria | url }}">{{ inEvidenza.data.categoria }}</a>
        <time datetime="{{ inEvidenza.date | dataIso }}">{{ inEvidenza.date | dataIt }}</time>
      </p>
      <h1 class="apertura-titolo"><a href="{{ inEvidenza.url | url }}">{{ inEvidenza.data.titolo }}</a></h1>
      {% if inEvidenza.data.sottotitolo %}
      <p class="apertura-sommario">{{ inEvidenza.data.sottotitolo }}</p>
      {% endif %}
    </article>

    <div class="secondarie">
      {% for articolo in tutti %}
        {% if loop.index > 1 and loop.index <= 3 %}
      <article class="secondaria">
        <p class="riga-meta">
          <a class="categoria" href="{{ articolo.data.categoria | urlCategoria | url }}">{{ articolo.data.categoria }}</a>
          <time datetime="{{ articolo.date | dataIso }}">{{ articolo.date | dataIt }}</time>
        </p>
        <h2 class="secondaria-titolo"><a href="{{ articolo.url | url }}">{{ articolo.data.titolo }}</a></h2>
      </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if tutti.length > 3 %}
<section class="container" aria-labelledby="ultime">
  <h2 class="titoletto" id="ultime">Ultime notizie</h2>
  <ul class="elenco">
    {% for articolo in tutti %}
      {% if loop.index > 3 and loop.index <= 9 %}
        {% include "card-articolo.njk" %}
      {% endif %}
    {% endfor %}
  </ul>
  <p class="altre"><a href="{{ '/ultime-notizie/' | url }}">Tutte le notizie</a></p>
</section>
{% endif %}

{% else %}

<section class="container">
  <div class="page-head">
    <h1>L'AI, spiegata.</h1>
    <p>{{ site.nome }} sceglie ogni giorno le notizie tecnologiche che contano, le verifica sulle fonti originali e le racconta in italiano, senza rumore.</p>
  </div>
  <div class="stato-vuoto">
    <h2>Nessun articolo pubblicato</h2>
    <p>
      Stiamo preparando i primi contenuti. Ogni articolo viene pubblicato
      solo dopo una verifica e un'approvazione della redazione.
    </p>
  </div>
</section>

{% endif %}
