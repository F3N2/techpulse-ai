---
layout: base.njk
pagination:
  data: categorie
  size: 1
  alias: cat
permalink: "/{{ cat.slug }}/"
eleventyComputed:
  titolo: "{{ cat.nome }}"
  descrizione: "{{ cat.descrizione }} Gli articoli di NEXORA nella sezione {{ cat.nome }}."
---
{% set articoliCat = collections.articoli | perCategoria(cat.nome) %}

<section class="container">
  <div class="page-head">
    <h1>{{ cat.nome }}</h1>
    <p>{{ cat.descrizione }}</p>
  </div>

  {% if articoliCat.length %}
  <ul class="elenco">
    {% for articolo in articoliCat %}
      {% include "card-articolo.njk" %}
    {% endfor %}
  </ul>
  {% else %}
  <div class="stato-vuoto">
    <h2>Nessun articolo in questa sezione</h2>
    <p>
      Non abbiamo ancora pubblicato articoli su questo tema. Ogni articolo
      viene pubblicato solo dopo una verifica e un'approvazione della redazione.
    </p>
    <p>
      <a class="btn btn-secondario" href="{{ '/ultime-notizie/' | url }}">
        Vai alle ultime notizie
      </a>
    </p>
  </div>
  {% endif %}
</section>
